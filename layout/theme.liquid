<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <script>document.documentElement.classList.replace('no-js', 'js');</script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  {%- liquid
    assign seo_title = page_title | default: shop.name
    assign seo_description = page_description
    if seo_description == blank and product
      assign seo_description = product.description | strip_html | truncate: 160
    elsif seo_description == blank and collection and collection.description != blank
      assign seo_description = collection.description | strip_html | truncate: 160
    elsif seo_description == blank
      assign seo_description = shop.description | strip_html | truncate: 160
    endif

    assign seo_image = page_image | default: settings.logo

    assign canonical = canonical_url
    if template contains 'collection' and collection
      assign has_active_filters = false
      for filter in collection.filters
        if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value
          assign has_active_filters = true
        endif
      endfor
      if has_active_filters
        assign canonical = collection.url
      endif
    endif
  -%}

  <link rel="canonical" href="{{ canonical }}">
  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  <title>
    {{ page_title }}{% if page_title == '' %}{{ shop.name }}{% endif %}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Página {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if seo_description != blank -%}
    <meta name="description" content="{{ seo_description | escape }}">
  {%- endif -%}

  {%- comment -%} Open Graph {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="{% if product %}product{% else %}website{% endif %}">
  <meta property="og:title" content="{{ seo_title | escape }}">
  {%- if seo_description != blank -%}
    <meta property="og:description" content="{{ seo_description | escape }}">
  {%- endif -%}
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">
  {%- if seo_image -%}
    <meta property="og:image" content="{{ seo_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
  {%- endif -%}

  {%- comment -%} Twitter Card {%- endcomment -%}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo_title | escape }}">
  {%- if seo_description != blank -%}
    <meta name="twitter:description" content="{{ seo_description | escape }}">
  {%- endif -%}
  {%- if seo_image -%}
    <meta name="twitter:image" content="{{ seo_image | image_url: width: 1200 }}">
  {%- endif -%}

  {%- comment -%} JSON-LD: Organization + WebSite (sitewide) {%- endcomment -%}
  {%- liquid
    assign social_links = ''
    if settings.social_instagram != blank
      assign social_links = social_links | append: settings.social_instagram | append: '|'
    endif
    if settings.social_facebook != blank
      assign social_links = social_links | append: settings.social_facebook | append: '|'
    endif
    if settings.social_tiktok != blank
      assign social_links = social_links | append: settings.social_tiktok | append: '|'
    endif
    assign social_links_array = social_links | split: '|'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
      {%- if settings.logo -%},
      "logo": {{ settings.logo | image_url: width: 300 | json }}
      {%- endif -%}
      {%- if social_links_array.size > 0 -%},
      "sameAs": {{ social_links_array | json }}
      {%- endif -%}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ shop.url }}/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>

  {{ 'inter-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'space-grotesk-700.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

  {{ content_for_header }}

  {% style %}
    :root {
      --color-background: {{ settings.color_background }};
      --color-surface: {{ settings.color_surface }};
      --color-text: {{ settings.color_text }};
      --color-text-muted: {{ settings.color_text_muted }};
      --color-primary: {{ settings.color_primary }};
      --color-accent: {{ settings.color_accent }};
      --color-border: {{ settings.color_border }};
      --font-heading: {{ settings.font_heading }};
      --font-body: {{ settings.font_body }};
      --page-width: {{ settings.page_width }}px;
    }
  {% endstyle %}

  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
</head>

<body>
  <a class="skip-to-content" href="#MainContent">Saltar al contenido</a>

  {% section 'header' %}

  <main id="MainContent" class="main-content">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <div class="cart-toast" data-cart-toast role="status" aria-live="polite"></div>
  {% render 'cart-drawer' %}

  <script>
    window.themeStrings = {
      addToCart: {{ 'products.product.add_to_cart' | t | json }},
      soldOut: {{ 'products.product.sold_out' | t | json }},
      unavailable: {{ 'products.product.unavailable' | t | json }},
      added: {{ 'products.product.added' | t | json }},
      addedToCart: {{ 'cart.added_to_cart' | t | json }},
      remove: {{ 'cart.remove' | t | json }},
      subtotal: {{ 'cart.subtotal' | t | json }},
      checkout: {{ 'cart.checkout' | t | json }},
      cartEmpty: {{ 'cart.empty' | t | json }},
      continueShopping: {{ 'general.continue_shopping' | t | json }},
      viewFullCart: {{ 'cart.view_full_cart' | t | json }},
      freeShippingReached: {{ 'cart.free_shipping.reached' | t | json }},
      freeShippingProgressTemplate: {{ 'cart.free_shipping.progress' | t | json }},
      currency: {{ cart.currency.iso_code | json }}
    };
    window.themeRoutes = {
      cartUrl: {{ routes.cart_url | json }},
      cartChangeUrl: {{ routes.cart_change_url | json }}
    };
    window.themeSettings = {
      freeShippingEnabled: {{ settings.free_shipping_bar_enabled | json }},
      freeShippingThresholdCents: {{ settings.free_shipping_threshold | times: 100 | json }}
    };
  </script>
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

  {%- comment -%}
    Premium motion layer (GSAP + ScrollTrigger + Lenis + SplitType + motion.js)
    is not needed for first paint or the LCP element, so it's kept off the
    critical path entirely: only requested after window.load, one file at a
    time, in dependency order. global.js (cart/nav/variants) still loads
    normally above and is unaffected.
  {%- endcomment -%}
  <script>
    window.addEventListener('load', function () {
      var motionScripts = [
        {{ 'gsap.min.js' | asset_url | json }},
        {{ 'scroll-trigger.min.js' | asset_url | json }},
        {{ 'lenis.min.js' | asset_url | json }},
        {{ 'split-type.min.js' | asset_url | json }},
        {{ 'motion.js' | asset_url | json }}
      ];
      function loadNext(index) {
        if (index >= motionScripts.length) return;
        var script = document.createElement('script');
        script.src = motionScripts[index];
        script.onload = function () { loadNext(index + 1); };
        script.onerror = function () { loadNext(index + 1); };
        document.body.appendChild(script);
      }
      loadNext(0);
    });
  </script>
</body>
</html>
