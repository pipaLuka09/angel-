<div class="section{% if section.settings.tight %} section--tight{% endif %}">
  <div class="page-width">
    <div class="section__header">
      <div>
        <h2 class="section__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      <a href="{{ routes.collections_url }}" class="btn btn--outline">{{ 'collection.view_all' | t }}</a>
    </div>

    <div class="collection-grid">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- if collection != blank -%}
          <a href="{{ collection.url }}" class="collection-card" {{ block.shopify_attributes }}>
            {%- if collection.image -%}
              <img src="{{ collection.image | image_url: width: 500 }}" alt="{{ collection.title }}" loading="lazy" width="500" height="375">
            {%- endif -%}
            <span class="collection-card__label">{{ collection.title }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Categorías",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Compra por categoría" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Todo lo que necesitas, organizado" },
    { "type": "checkbox", "id": "tight", "label": "Espaciado reducido", "default": false }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
