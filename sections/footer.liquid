<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__about">
        <h3>{{ 'footer.about_heading' | t }}</h3>
        <p>{{ section.settings.about_text }}</p>
        <div class="site-footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_whatsapp != blank -%}
            <a href="https://wa.me/{{ settings.social_whatsapp }}" aria-label="WhatsApp" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="site-footer__categories">
        <h3>{{ 'footer.categories_heading' | t }}</h3>
        <ul>
          {%- for block in section.blocks -%}
            {%- if block.type == 'category_link' -%}
              <li><a href="{{ block.settings.collection.url }}">{{ block.settings.collection.title | default: block.settings.label }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="site-footer__links">
        <h3>{{ 'footer.links_heading' | t }}</h3>
        <ul>
          {%- for link in linklists.footer.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="site-footer__contact">
        <h3>Contacto</h3>
        <ul>
          {%- if shop.email -%}
            <li><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></li>
          {%- endif -%}
          {%- if settings.social_whatsapp != blank -%}
            <li><a href="https://wa.me/{{ settings.social_whatsapp }}" target="_blank" rel="noopener">WhatsApp</a></li>
          {%- endif -%}
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    {
      "type": "textarea",
      "id": "about_text",
      "label": "Texto sobre la tienda",
      "default": "Gadgets y tecnología para simplificar tu día a día: carga rápida, audio, seguridad y accesorios que sí funcionan."
    }
  ],
  "blocks": [
    {
      "type": "category_link",
      "name": "Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texto alternativo (si no eliges colección)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "category_link", "settings": { "label": "Carga y Energía" } },
      { "type": "category_link", "settings": { "label": "Audio y Sonido" } },
      { "type": "category_link", "settings": { "label": "Accesorios para Celular" } },
      { "type": "category_link", "settings": { "label": "Accesorios para Auto" } },
      { "type": "category_link", "settings": { "label": "Privacidad y Seguridad" } },
      { "type": "category_link", "settings": { "label": "Tecnología y Gadgets IA" } }
    ]
  }
}
{% endschema %}
