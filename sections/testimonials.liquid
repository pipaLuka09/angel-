<div class="section section--tight">
  <div class="page-width">
    <div class="section__header reveal">
      <div>
        <h2 class="section__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="testimonial-grid">
        {%- for block in section.blocks -%}
          <div class="testimonial-card reveal" {{ block.shopify_attributes }}>
            <div class="testimonial-card__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24" class="{% if i <= block.settings.rating %}is-filled{% endif %}"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
              {%- endfor -%}
            </div>
            <p class="testimonial-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <p class="testimonial-card__author">
              {{ block.settings.author }}
              {%- if block.settings.location != blank -%}
                <span>&middot; {{ block.settings.location }}</span>
              {%- endif -%}
            </p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonios",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Lo que dicen nuestros clientes" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Reseñas reales de compras en ShopNow" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Reseña", "default": "Escribe aquí la reseña real de un cliente." },
        { "type": "text", "id": "author", "label": "Nombre del cliente", "default": "Nombre del cliente" },
        { "type": "text", "id": "location", "label": "Ciudad (opcional)" },
        { "type": "range", "id": "rating", "label": "Calificación", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonios",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
