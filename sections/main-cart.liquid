<div class="page-width">
  <h1>{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="cart-empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'general.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    {%- render 'free-shipping-bar' -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart">
      <div class="cart-items">
        {%- for item in cart.items -%}
          <div class="cart-line">
            <a href="{{ item.url }}">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.image.alt | default: item.title }}" width="90" height="90" loading="lazy">
              {%- endif -%}
            </a>
            <div>
              <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
              {%- unless item.variant.title == 'Default Title' -%}
                <div class="cart-line__variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="cart-line__variant">{{ item.original_price | money }}</div>
              <a href="{{ item.url_to_remove }}" class="cart-line__remove">{{ 'cart.remove' | t }}</a>
            </div>
            <div class="quantity-selector">
              <button type="button" data-quantity-step="-1" aria-label="Reducir cantidad">&minus;</button>
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'cart.quantity' | t }}">
              <button type="button" data-quantity-step="1" aria-label="Aumentar cantidad">&plus;</button>
            </div>
            <div class="cart-line__total">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-summary">
        <div class="cart-summary__row">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <button type="submit" name="update" class="btn btn--outline btn--full" style="margin-bottom: 12px;">{{ 'cart.update' | t }}</button>
        <button type="submit" name="checkout" class="btn btn--primary btn--full">{{ 'cart.checkout' | t }}</button>

        <p class="cart-summary__secure">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 3 6v6c0 5 4 9 9 10 5-1 9-5 9-10V6z"></path></svg>
          {{ 'cart.secure_checkout' | t }}
        </p>

        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="cart-summary__payments">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Carrito",
  "settings": []
}
{% endschema %}
