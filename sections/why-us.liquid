<div class="section section--tight">
  <div class="page-width">
    <div class="section__header reveal">
      <div>
        <h2 class="section__heading">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="why-us-grid">
      {%- for block in section.blocks -%}
        <div class="why-us-item reveal" {{ block.shopify_attributes }}>
          <div class="why-us-item__icon">
            {%- case block.settings.icon -%}
              {%- when 'shipping' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><path d="M16 8h4l3 3v5h-7V8z"></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 3 6v6c0 5 4 9 9 10 5-1 9-5 9-10V6z"></path></svg>
              {%- when 'card' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
              {%- when 'support' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 18 0v6a2 2 0 0 1-2 2h-2v-8h4"></path><path d="M3 18v-6a9 9 0 0 1 1-4"></path></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle></svg>
            {%- endcase -%}
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Por qué elegirnos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Por qué comprar en ShopNow" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "shipping", "label": "Envío" },
            { "value": "shield", "label": "Garantía" },
            { "value": "card", "label": "Pago" },
            { "value": "support", "label": "Soporte" }
          ],
          "default": "shipping"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Envío rápido" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Recibe tus pedidos en la puerta de tu casa." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Por qué elegirnos",
      "blocks": [
        { "type": "feature", "settings": { "icon": "shipping", "title": "Envío rápido", "text": "Recibe tus gadgets en la puerta de tu casa en pocos días." } },
        { "type": "feature", "settings": { "icon": "shield", "title": "Garantía", "text": "Productos revisados y con garantía en cada compra." } },
        { "type": "feature", "settings": { "icon": "card", "title": "Pago seguro", "text": "Paga con tu método favorito, protegido en todo momento." } },
        { "type": "feature", "settings": { "icon": "support", "title": "Soporte real", "text": "Te ayudamos por WhatsApp antes y después de tu compra." } }
      ]
    }
  ]
}
{% endschema %}
