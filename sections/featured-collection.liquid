{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
-%}
<div class="section{% if section.settings.tight %} section--tight{% endif %}">
  <div class="page-width">
    <div class="section__header">
      <div>
        <h2 class="section__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="btn btn--outline">{{ 'collection.view_all' | t }}</a>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products limit: products_to_show -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p>{{ 'collection.empty' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Más vendidos en Carga y Energía" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Cargadores, cables y accesorios que nunca te dejan sin batería" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "products_to_show", "label": "Productos a mostrar", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "tight", "label": "Espaciado reducido", "default": false }
  ],
  "presets": [
    { "name": "Colección destacada" }
  ]
}
{% endschema %}
