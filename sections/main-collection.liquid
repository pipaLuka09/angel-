<nav class="breadcrumbs page-width" aria-label="breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
    <li aria-current="page">{{ collection.title }}</li>
  </ol>
</nav>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
    ]
  }
</script>

<div class="collection-header page-width">
  <h1>{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    <p>{{ collection.description }}</p>
  {%- endif -%}
</div>

<form method="get" action="{{ collection.url }}" class="page-width collection-layout">
  {%- if collection.filters != empty -%}
    {%- liquid
      assign has_active_filters = false
      for filter in collection.filters
        if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value
          assign has_active_filters = true
        endif
      endfor
    -%}
    <aside class="collection-filters">
      <details class="collection-filters__toggle" open>
        <summary>
          {{ 'collection.filters' | t }}
          {%- if has_active_filters %} <span class="collection-filters__badge"></span>{% endif -%}
        </summary>
        <div class="collection-filters__body">
          {%- for filter in collection.filters -%}
            <div class="filter-group">
              <h3>{{ filter.label }}</h3>
              {%- case filter.type -%}
                {%- when 'list', 'boolean' -%}
                  <ul class="filter-group__list">
                    {%- for value in filter.values -%}
                      <li>
                        <label class="filter-checkbox{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                            onchange="this.form.submit()"
                          >
                          <span>{{ value.label }}</span>
                          <span class="filter-checkbox__count">({{ value.count }})</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <div class="filter-price">
                    <label>
                      <span class="visually-hidden">{{ 'collection.price_min' | t }}</span>
                      <input type="number" name="{{ filter.min_value.param_name }}" placeholder="{{ 'collection.price_min' | t }}" value="{{ filter.min_value.value }}" min="0">
                    </label>
                    <span aria-hidden="true">&ndash;</span>
                    <label>
                      <span class="visually-hidden">{{ 'collection.price_max' | t }}</span>
                      <input type="number" name="{{ filter.max_value.param_name }}" placeholder="{{ 'collection.price_max' | t }}" value="{{ filter.max_value.value }}" min="0">
                    </label>
                    <button type="submit" class="btn btn--outline">{{ 'collection.apply' | t }}</button>
                  </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}

          {%- if has_active_filters -%}
            <a href="{{ collection.url }}" class="filter-clear">{{ 'collection.clear_filters' | t }}</a>
          {%- endif -%}
        </div>
      </details>
    </aside>
  {%- endif -%}

  <div class="collection-main">
    <div class="collection-toolbar">
      <span>{{ collection.products_count }} productos</span>
      <div>
        <label for="SortBy" class="visually-hidden">{{ 'collection.sort_by' | t }}</label>
        <select name="sort_by" id="SortBy" onchange="this.form.submit()">
          <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>{{ 'collection.sort.best_selling' | t }}</option>
          <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>{{ 'collection.sort.price_ascending' | t }}</option>
          <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>{{ 'collection.sort.price_descending' | t }}</option>
          <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>{{ 'collection.sort.title_ascending' | t }}</option>
          <option value="title-descending" {% if collection.sort_by == 'title-descending' %}selected{% endif %}>{{ 'collection.sort.title_descending' | t }}</option>
          <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>{{ 'collection.sort.created_descending' | t }}</option>
        </select>
      </div>
    </div>

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <div class="product-grid">
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p>{{ 'collection.empty' | t }}</p>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}">{{ 'pagination.previous' | t }}</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span class="current">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}">{{ 'pagination.next' | t }}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</form>

{% schema %}
{
  "name": "Página de colección",
  "settings": []
}
{% endschema %}
