{%- liquid
  assign product = product
  assign variant = product.selected_or_first_available_variant
-%}
<div class="page-width product-main">
  <div class="product-gallery" data-product-gallery>
    <div class="product-gallery__main">
      <img
        src="{{ variant.featured_image | default: product.featured_image | image_url: width: 900 }}"
        alt="{{ product.featured_image.alt | default: product.title }}"
        data-product-main-image
        width="900"
        height="900"
      >
    </div>
    {%- if product.images.size > 1 -%}
      <div class="product-gallery__thumbs">
        {%- for image in product.images -%}
          <img
            src="{{ image | image_url: width: 150 }}"
            alt="{{ image.alt | default: product.title }}"
            data-gallery-thumb
            data-full-src="{{ image | image_url: width: 900 }}"
            class="{% if forloop.first %}is-active{% endif %}"
            width="68"
            height="68"
          >
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-info">
    {%- if product.vendor != blank -%}
      <div class="product-info__vendor">{{ product.vendor }}</div>
    {%- endif -%}
    <h1 class="product-info__title">{{ product.title }}</h1>

    {%- render 'price', product: product -%}

    <p class="product-info__availability" data-availability>
      {%- unless variant.available -%}{{ 'products.product.sold_out' | t }}{%- endunless -%}
    </p>

    <product-form>
      <form method="post" action="{{ routes.cart_add_url }}" data-product-form>
        <script type="application/json" data-product-json>{{ product.json }}</script>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="product-form__option">
              <label for="Option-{{ option.position }}">{{ option.name }}</label>
              <select id="Option-{{ option.position }}" data-option-index="{{ option.position | minus: 1 }}">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}" {% if value == option.selected_value %}selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="quantity-selector">
          <button type="button" data-quantity-step="-1" aria-label="Reducir cantidad">&minus;</button>
          <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.quantity' | t }}">
          <button type="button" data-quantity-step="1" aria-label="Aumentar cantidad">&plus;</button>
        </div>

        <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id>

        <button type="submit" class="btn btn--primary btn--full" data-add-to-cart {% unless variant.available %}disabled{% endunless %}>
          {%- if variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
      </form>
    </product-form>

    <ul class="trust-badges">
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><path d="M16 8h4l3 3v5h-7V8z"></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
        <span>{{ section.settings.badge_shipping }}</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 3 6v6c0 5 4 9 9 10 5-1 9-5 9-10V6z"></path></svg>
        <span>{{ section.settings.badge_warranty }}</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
        <span>{{ section.settings.badge_payment }}</span>
      </li>
    </ul>

    {%- if product.description != blank -%}
      <div class="product-info__description">{{ product.description }}</div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        {%- render block -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{%- if section.settings.show_related -%}
  {%- liquid
    assign related_collection = product.collections.first
  -%}
  {%- if related_collection -%}
    <div class="section related-products">
      <div class="page-width">
        <div class="section__header reveal">
          <h2 class="section__heading related-products__heading">{{ section.settings.related_heading }}</h2>
        </div>
        <div class="related-products__scroller">
          {%- assign shown = 0 -%}
          {%- for related in related_collection.products -%}
            {%- if related.id != product.id and shown < section.settings.related_limit -%}
              {%- render 'product-card-related', product: related -%}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Página de producto",
  "settings": [
    { "type": "text", "id": "badge_shipping", "label": "Texto insignia de envío", "default": "Envío a todo Ecuador" },
    { "type": "text", "id": "badge_warranty", "label": "Texto insignia de garantía", "default": "Garantía de fábrica" },
    { "type": "text", "id": "badge_payment", "label": "Texto insignia de pago", "default": "Pago 100% seguro" },
    { "type": "checkbox", "id": "show_related", "label": "Mostrar productos relacionados", "default": true },
    { "type": "text", "id": "related_heading", "label": "Encabezado de relacionados", "default": "También te puede interesar" },
    { "type": "range", "id": "related_limit", "label": "Máximo de productos relacionados", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "blocks": [
    { "type": "@app" }
  ]
}
{% endschema %}
