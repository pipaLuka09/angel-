{%- comment -%}
  Floating WhatsApp button, site-wide. Only renders when a WhatsApp number
  is set and the merchant hasn't turned it off; reuses the same number as
  the footer social link (settings.social_whatsapp).
{%- endcomment -%}
{%- if settings.social_whatsapp != blank and settings.whatsapp_floating_button_enabled -%}
  {%- assign wa_message = settings.whatsapp_button_message | default: 'Hola, tengo una pregunta.' -%}
  <a
    class="whatsapp-float"
    href="https://wa.me/{{ settings.social_whatsapp }}?text={{ wa_message | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ 'general.whatsapp_contact' | t }}"
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.02c-.24.68-1.4 1.32-1.93 1.4-.5.08-1.12.11-1.8-.11-.42-.13-.95-.31-1.63-.6-2.87-1.24-4.74-4.12-4.89-4.31-.14-.19-1.16-1.55-1.16-2.95 0-1.4.73-2.09.99-2.38.26-.28.57-.35.76-.35h.55c.18 0 .42-.07.65.5.24.58.82 2 .89 2.14.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.16-.29.36-.42.49-.14.13-.28.28-.12.55.16.28.71 1.18 1.53 1.91 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.68-.79.87-1.06.18-.28.37-.23.62-.14.26.09 1.63.77 1.91.91.28.14.47.21.53.33.07.13.07.71-.17 1.39z"></path>
    </svg>
  </a>
{%- endif -%}
