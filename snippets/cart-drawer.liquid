{%- comment -%}
  Cart drawer shell. Content (line items, subtotal, checkout) is rendered
  client-side by assets/global.js from the Cart AJAX API, so it always
  reflects the live cart without a page reload.
{%- endcomment -%}
<div class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-drawer-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
    <div class="cart-drawer__header">
      <h2>{{ 'cart.title' | t }}</h2>
      <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="{{ 'general.close' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div data-cart-drawer-free-shipping></div>
    <div class="cart-drawer__body" data-cart-drawer-body></div>
    <div class="cart-drawer__footer" data-cart-drawer-footer></div>
  </div>
</div>
