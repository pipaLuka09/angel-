# Salida de build.py: se regenera con `python3 build.py`
tapwork-nfc.html

# La misma salida, copiada con el nombre que pide Netlify al subirla.
brand/entregables/index.html

# Fotogramas intermedios de advideos.py y webclips.py.
capture/.work/
capture/.workweb/

# Página armada por buildsimple.py: se regenera con `python3 buildsimple.py`
# a partir de build.py, webclips/ e img1080/, y duplicaría esos medios en git.
dist/

# Caché de Python.
__pycache__/

# Intermedios de card.py: el HTML se regenera, los PDF/PNG salen de él.
print/out/*.html
