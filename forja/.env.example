# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Clave de servicio. SOLO servidor — fíjate que NO lleva el prefijo
# NEXT_PUBLIC_, precisamente para que Next no la incruste en el bundle
# del navegador. Salta todas las políticas RLS.
#
# La usa una sola cosa: el alta de socios desde el panel, que necesita
# crear cuentas de Auth. Si falta, el resto de la app funciona igual y
# solo ese formulario falla con un mensaje claro.
#
# Está en Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app. Es la que se graba en los stickers NFC:
# el sticker guarda <NEXT_PUBLIC_SITE_URL>/m/<codigo>
# Si se deja vacía, la hoja de stickers usa el host de la petición y te
# avisa de que no está configurada.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
